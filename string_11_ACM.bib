@inproceedings{10.1145/3817395.3817419,
author = {Yue, Chengyang},
title = {An Intelligent Scheduling Method for Air-Ground Collaborative Resources in Mountainous Internet of Vehicles Based on Digital Twin},
year = {2026},
isbn = {9798400722493},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3817395.3817419},
doi = {10.1145/3817395.3817419},
abstract = {The Internet of Vehicles (IoV) faces significant challenges in complex mountainous environments, including uneven communication coverage, limited edge computing resources, and difficulties in dynamic resource scheduling. To address these issues, this paper proposes a digital twin-based integrated air-ground collaborative resource orchestration system for the IoV in mountainous areas. By constructing a high-fidelity dynamic virtual replica, the system integrates multi-source data from vehicles, unmanned aerial vehicles (UAVs), and base stations in real-time, achieving precise mapping and overall situational awareness of the mountainous traffic environment. At the model layer, a computational task scheduling model and a UAV deployment planning model is designed, employing intelligence framework to conduct simulation-based analysis and optimal strategy selection within the digital twin. This enables the dynamic and intelligent orchestration of communication and computational resources. A case study demonstrates that the system can significantly improve task completion rates and system robustness in typical mountainous road sections, offering a viable solution for ensuring the reliable operation of IoV in challenging mountainous terrains.},
booktitle = {Proceedings of the 2026 International Conference on Big Data and Intelligent Manufacturing},
pages = {154–161},
numpages = {8},
keywords = {Digital twin, Edge Computing, Internet of Vehicles, Unmanned Aerial Vehicle},
location = {Jinan, China},
series = {BDIM '26}
}

@inproceedings{10.1145/3756884.3766010,
author = {Vona, Francesco and Amer, Mohamed and Abdellatif, Omar and Hallmann, Michelle Celina and Warsinke, Maximilian and Mihaita, Adriana-Simona and Voigt-Antons, Jan-Niklas},
title = {Unmanned Aerial Vehicles Control in a Digital Twin: Exploring the Effect of Different Points of View on User Experience in Virtual Reality},
year = {2025},
isbn = {9798400721182},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3756884.3766010},
doi = {10.1145/3756884.3766010},
abstract = {Controlling Unmanned Aerial Vehicles (UAVs) is a cognitively demanding task, with accidents often arising from insufficient situational awareness, inadequate training, and bad user experiences. Providing more intuitive and immersive visual feedback—particularly through Digital Twin technologies—offers new opportunities to enhance pilot awareness and the overall experience quality. In this study, we investigate how different virtual points of view (POVs) influence user experience and performance during UAV piloting in Virtual Reality (VR), utilizing a digital twin that faithfully replicates the real-world flight environment. We developed a VR application that enables participants to control a physical DJI Mini 4 Pro drone while immersed in a digital twin with four distinct camera perspectives: Baseline View (static external), First Person View, Chase View, and Third Person View. Nineteen participants completed a series of ring-based obstacle courses from each perspective. In addition to objective flight data, we collected standardized subjective assessments of user experience, presence, workload, cybersickness, and situational awareness. Quantitative analyses revealed that the First Person View was associated with significantly higher mental demand and effort, greater trajectory deviation, but smoother control inputs compared to the Third Person and Chase perspectives. Complementing these findings, preference data indicated that the Third Person View was most consistently favored, whereas the First Person View elicited polarized reactions.},
booktitle = {Proceedings of the 2025 31st ACM Symposium on Virtual Reality Software and Technology},
articleno = {19},
numpages = {11},
keywords = {Unmanned Aerial Vehicles, Digital Twin, Virtual Reality, User Experience},
location = {Montreal, QC, Canada},
series = {VRST '25}
}

@inproceedings{10.1145/3711875.3737659,
author = {Cauwe, Dorian and Wang, Chenyang and Han, Qi},
title = {GazeboNS3: A Digital Twin System for UAV Swarms},
year = {2025},
isbn = {9798400714535},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3711875.3737659},
doi = {10.1145/3711875.3737659},
abstract = {Unmanned Aerial Vehicles (UAVs) have advanced significantly, with multi-UAV systems offering advantages such as redundancy, cost-effectiveness, and less dependency on infrastructure. These systems can benefit applications like remote surveillance, search and rescue, and environmental monitoring. Ideally, UAVs should behave distributively and make their own decisions. However, developing these distributed algorithms for multi-UAV systems presents challenges, particularly in real-world testing, where hardware constraints, environmental dependencies, and limited analytics can hinder the development progress. Simulations have emerged as a key solution, allowing for rapid iteration and detailed analytics. Yet, current simulators often lack the capability to accurately model both the physical dynamics of UAVs and the complexity of their communication networks. This paper introduces GazeboNS31, a Digital Twin system designed to bridge this gap. Specifically, we combine the Gazebo physics simulator, the NS-3 network simulator, the Ardupilot's flight controller, and our empirical measurements of energy consumption and computation time on various commonly used onboard computers. Experiment results show that GazeboNS3 enables seamless emulation of UAVs' behavior and communication in realistic environments.},
booktitle = {Proceedings of the 23rd Annual International Conference on Mobile Systems, Applications and Services},
pages = {699–704},
numpages = {6},
keywords = {UAV swarm, UAV networks, digital twin},
location = {Anaheim, CA, USA},
series = {MobiSys '25}
}

@inproceedings{10.1145/3737895.3768305,
author = {Sadique, Joarder Jafor and Khan, Mahfizur Rahman and Ibrahim, Ahmed S.},
title = {UAV-aided Fast Data Collection via Machine Learning Using AERPAW's Digital Twin},
year = {2025},
isbn = {9798400719721},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3737895.3768305},
doi = {10.1145/3737895.3768305},
abstract = {Unmanned aerial vehicles (UAVs) have emerged as essential components for 5G and beyond networks. Particularly, UAVs serve as aerial data mules, capable of efficiently collecting and transferring data from geographically dispersed ground-based nodes, such as ground base stations. However, practical limitations like battery life constraints, stringent mission timeliness, and varying wireless conditions present significant challenges for efficient data collection. To reduce the mission completion time, optimizing UAV's trajectory is often considered a primary challenge. In addition, data collection time under hovering mode also greatly affect the mission time. In this work, we propose machine learning (ML)-based UAV-aided data collection model that leverages K-means clustering to identify optimal waypoints near each base station within Aerial Experimentation and Research Platform for Advanced Wireless (AERPAW) geofence area, located in Raleigh, North Carolina, USA. By adopting the clustering strategy, our primary goal is to reduce flight time without compromising the high signal-to-noise ratio (SNR) across trajectories. Our proposed model also tackles the challenge of dynamic hovering time adjustment at each waypoint by incorporating an adaptive approach based on instantaneous link quality and data volume. To validate the proposed data collection model, we utilize a digital twin simulation environment from AERPAW. The results emulated over the AERPAW's digital twin demonstrate the effectiveness of the proposed algorithm, ensuring enhanced efficiency in the UAV-aided fast data collection strategy.},
booktitle = {Proceedings of the ACM Workshop on Wireless Network Testbeds, Experimental Evaluation &amp; Characterization},
pages = {89–96},
numpages = {8},
keywords = {digital twin, data collection, k-means clustering, trajectory optimization, and UAV},
location = {Hong Kong, China},
series = {WiNTECH '25}
}

@inproceedings{10.1145/3664476.3670914,
author = {Wurzenberger, Markus and Krenn, Stephan and Landauer, Max and Skopik, Florian and Perner, Cora and L{\"o}tj{\"o}nen, Jarno and P{\"a}ij{\"a}nen, Jani and Gardikis, Georgios and Alabasis, Nikos and Sakerman, Liisa and Omri, Kristiina and R{\"o}ning, Juha and Halunen, Kimmo and Thouvenot, Vincent and Weise, Martin and Rauber, Andreas and Gkioulos, Vasileios and Katsikas, Sokratis and Sabetta, Luigi and Bonato, Jacopo and Ort{\'i}z, Roc{\'i}o and Navarro, Daniel and Stamatelatos, Nikolaos and Avdoulas, Ioannis and Mayer, Rudolf and Ekelhart, Andreas and Giannoulakis, Ioannis and Kafetzakis, Emmanouil and Corsi, Antonello and Lechner, Ulrike and Schmitt, Corinna},
title = {NEWSROOM: Towards Automating Cyber Situational Awareness Processes and Tools for Cyber Defence},
year = {2024},
isbn = {9798400717185},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3664476.3670914},
doi = {10.1145/3664476.3670914},
abstract = {Cyber Situational Awareness (CSA) is an important element in both cyber security and cyber defence to inform processes and activities on strategic, tactical, and operational level. Furthermore, CSA enables informed decision making. The ongoing digitization and interconnection of previously unconnected components and sectors equally affects the civilian and military sector. In defence, this means that the cyber domain is both a separate military domain as well as a cross-domain and connecting element for the other military domains comprising land, air, sea, and space. Therefore, CSA must support perception, comprehension, and projection of events in the cyber space for persons with different roles and expertise. This paper introduces NEWSROOM, a research initiative to improve technologies, methods, and processes specifically related to CSA in cyber defence. For this purpose, NEWSROOM aims to improve methods for attacker behavior classification, cyber threat intelligence (CTI) collection and interaction, secure information access and sharing, as well as human computer interfaces (HCI) and visualizations to provide persons with different roles and expertise with accurate and easy to comprehend mission- and situation-specific CSA. Eventually, NEWSROOM’s core objective is to enable informed and fast decision-making in stressful situations of military operations. The paper outlines the concept of NEWSROOM and explains how its components can be applied in relevant application scenarios.},
booktitle = {Proceedings of the 19th International Conference on Availability, Reliability and Security},
articleno = {69},
numpages = {11},
keywords = {CSA, Cyber Defence, Cyber Information Warfare, Cyber Situational Awareness, Mission-specific information},
location = {Vienna, Austria},
series = {ARES '24}
}

@article{10.1145/3778168,
author = {Shibli, Fatima and Tufekci, Burak and Tunc, Cihan and Laidig, Robin},
title = {Leveraging LLM Decision-Making in the Internet of Drone Things (IoDT) Ecosystem},
year = {2026},
issue_date = {September 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {3},
number = {3},
url = {https://doi.org/10.1145/3778168},
doi = {10.1145/3778168},
abstract = {The Internet of Drone Things (IoDT) advances autonomous drone operations by integrating live sensor inputs with environmental and situational awareness and intelligent decision-making capabilities. The full capabilities of IoDT remain limited by the difficulties of dynamic task assignment and path optimization, along with adaptive decision-making, when operating in complex environments such as disaster relief and smart agriculture. Traditional task-scheduling techniques have difficulty adapting to real-time changes caused by dynamic constraints such as weather variations, battery limitations, and drone malfunctions. We present an LLM-based task scheduling framework that uses Large Language Models (LLMs) to improve task prioritization performance and path planning accuracy while minimizing operational failures. We combine heuristic algorithms (A*, Dijkstra) with decision-making processes driven by LLMs to allow drones to adapt to environmental changes while optimizing efficiency and resource consumption. Integrating LLM technology into IoDT operations results in up to 95% task completion rates and improves the scenario completion time by up to 42%, while adding reasonable computational overhead. Our framework demonstrates improved task adaptability, battery efficiency, and stronger system resilience against non-LLM baselines during disaster relief and package delivery operations. Our research shows that LLM-based IoDT task management has transformative potential, leading to the development of more innovative and autonomous drone ecosystems.},
journal = {ACM J. Auton. Transport. Syst.},
month = may,
articleno = {19},
numpages = {29},
keywords = {Drones, internet of things, internet of drone things, IoDT, large language model, LLM, simulator, lightweight simulation, algorithm development}
}

@inproceedings{10.1145/3828183.3828364,
author = {Li, Haidong},
title = {A Multi-Agent Reinforcement Learning and Digital Twin Driven Intelligent Teaching System for Low-Altitude Logistics Talent Cultivation},
year = {2026},
isbn = {9798400723322},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3828183.3828364},
doi = {10.1145/3828183.3828364},
abstract = {Background: The rapid development of the low-altitude economy has created an urgent demand for talents mastering advanced skills such as dynamic airspace collaboration, multi-agent decision-making, and real-time path planning. Traditional training modes face severe challenges including high costs, high risks, and a lack of intelligent adaptive guidance.Objectives: This study aims to design, implement, and validate an intelligent teaching system driven by multi-agent reinforcement learning (MARL) and digital twin (DT). The core objective is to develop a computer system capable of simulating complex low-altitude logistics scenarios, providing personalized adversarial training, and delivering intelligent feedback, so as to address the efficiency and adaptability issues in skills training.Methods: A design science research paradigm in computing is adopted. First, a high-fidelity, interactive digital twin simulation environment is constructed based on the Unity3D engine and real GIS data. Second, the multi-UAV collaborative delivery task is formalized as a partially observable Markov game, and a MARL decision engine based on the MADDPG framework is designed and implemented with algorithm optimizations for credit assignment and exploration efficiency. Finally, an AI tutor module integrated with large language models (LLM) and domain knowledge graphs is developed for automated generation of diagnostic feedback.Results: Technical evaluations show that the optimized MADDPG algorithm achieves a 91.3% task success rate and the lowest number of collisions in test scenarios, significantly outperforming baseline algorithms. The digital twin system maintains a rendering frame rate of &gt;60 FPS under complex scenarios. Feedback generated by the AI tutor receives a relevance score of over 82% in expert evaluations. Teaching experiments reveal that the experimental group (N=30) using the system shows a 15.6% improvement in operational efficiency and a 32.4% reduction in planning errors compared with the control group (p&lt;0.01).Conclusions: The main contributions of this study lie in the technical integration, algorithm optimization, and empirical validation of a MARL-DT-LLM intelligent teaching system. The system provides a scalable, data-driven solution for complex skills training such as low-altitude logistics, verifying the potential of advanced computer technologies to reshape vocational education models.},
booktitle = {Proceedings of the 3rd International Conference on Educational Digitalization and Computer Science in the Guangdong-Hong Kong-Macao Greater Bay Area},
pages = {1177–1182},
numpages = {6},
keywords = {Computer applications in education, Digital Twin (DT), Intelligent teaching system, Large Language Model (LLM), Low-altitude logistics, Multi-Agent Reinforcement Learning (MARL)},
location = {Zhuhai, China},
series = {EDCS '26}
}

@inproceedings{10.1145/3786163.3788451,
author = {da Silva, Ana Clara Ara{\'u}jo Gomes and Teixeira J{\'u}nior, Gilmar and Paes, Carlos Eduardo de Barros and Lima, Eliomar Ara{\'u}jo de and Neto, Valdemar Vicente Graciano},
title = {A Conceptual Model of Systems-of-Systems for Wildfire Response: Insights from a Rapid Review Applied to the Cerrado Biome},
year = {2026},
isbn = {9798400723957},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3786163.3788451},
doi = {10.1145/3786163.3788451},
abstract = {Wildfires are complex phenomena that involve multiple stakeholders, technologies, and layers of coordination, making their management a challenging task. This paper presents a conceptual model based on the System-of-Systems (SoS) perspective for wildfire response, developed from a rapid review of 24 studies addressing technological, organizational, and environmental aspects. This conceptual model not only consolidates fragmented efforts in wildfire response but also enhances coordination, collaboration, and sustainability across distributed stakeholders. The analysis identified interoperability gaps, limited communication between systems, and the absence of integrated frameworks for decision-making. The proposed model articulates multiple layers—observation, communication, coordination, and resilient operations—supporting collaborative action. By framing wildfire management as a SoS, this work contributes to improving preparedness, response, and resilience in fire-prone regions such as the Brazilian Cerrado.},
booktitle = {Proceedings of the 14th IEEE/ACM International Workshop on Software Engineering for Systems-of-Systems and Software Ecosystems},
pages = {24–32},
numpages = {9},
keywords = {Systems-of-Systems; Wildfire management; Cerrado; Rapid review; Sustainability},
location = {Rio de Janeiro, Brazil},
series = {SESoS '26}
}

@inproceedings{3643142.3643307,
author = {Lopes, Paulo Victor and Chen, Siyuan and S{\'a}nchez, Juan Pablo Gonz{\'a}lez and Bekar, Ebru Turanoglu and Bokrantz, Jon and Skoogh, Anders},
title = {Data-Driven Smart Maintenance Decision Analysis: A Drone Factory Demonstrator Combining Digital Twins and Adapted AHP},
year = {2024},
isbn = {9798350369663},
publisher = {IEEE Press},
abstract = {The concept of Digital Twins has gained significant attention in recent years due to its potential for improving the performance of production systems. One promising area for Digital Twins is Smart Maintenance, enabling the simulation of different strategies without disrupting operations in the real system. This study proposes a high-level framework to integrate Digital Twins to support Smart Maintenance data-driven decision making in production lines. We implement, then, a case study of a lab scale drone factory to demonstrate how the production line performance evaluation is made under different what-if maintenance scenarios. The effects of this Smart Maintenance decision analysis approach were evaluated according to Key Performance Indicators from literature. The identified contributions are: (i) Digital Twin demonstrator focused on smart maintenance; (ii) implementation of smart maintenance data-driven decision analysis concepts; (iii) design and evaluation of what-if maintenance scenarios.},
booktitle = {Proceedings of the Winter Simulation Conference},
pages = {1996–2007},
numpages = {12},
location = {San Antonio, Texas, USA},
series = {WSC '23}
}

@inproceedings{10.1145/3785987.3786008,
author = {Li, Haidong},
title = {Fusing Specialty-Innovation Integration and AI-Driven Pedagogy: A Vocational Education Framework for Cultivating Talent in the Emerging Low-Altitude Logistics Industry},
year = {2026},
isbn = {9798400720956},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3785987.3786008},
doi = {10.1145/3785987.3786008},
abstract = {The low-altitude logistics (LAL) industry—a pivotal manifestation of new quality productive forces—faces severe talent shortages despite rapid global expansion. To address this critical gap, we propose an innovative vocational education framework integrating Specialty-Innovation principles (Specialization and innovation) with AI-driven pedagogy, featuring: A tri-level knowledge architecture(Foundation/Application/Expansion) for technical competency building; A four-step teaching methodology (Scenario→Task→Tool→Evaluation) for practical skill development; An AI-powered platform enabling personalized learning paths and dynamic assessment. Validated through three iterative action research cycles, results demonstrate 46%↑ technical proficiency in AI/route optimization, 80%↑ innovation project engagement, and 9.2/10 industry alignment. This replicable model establishes a sustainable talent pipeline for next-generation LAL ecosystems.},
booktitle = {Proceedings of the 2025 2nd International Conference on Artificial Intelligence and Future Education},
pages = {126–133},
numpages = {8},
keywords = {Artificial Intelligence (AI), Low-Altitude Logistics, Pedagogy Reform, Specialty-Innovation Integration, Talent Cultivation, Vocational Education},
location = {Beijing, China},
series = {AIFE '25}
}

@inproceedings{10.1145/3597063.3597361,
author = {Carlson, Benjamin and Wang, Chenyang and Han, Qi},
title = {RAREST: Emulation of Augmented Reality Assisted Multi-UAV-UGV Systems},
year = {2023},
isbn = {9798400702136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3597063.3597361},
doi = {10.1145/3597063.3597361},
abstract = {AR-assisted multi-UAV-UGV systems are versatile robotic platforms for challenging missions. However, these systems face several challenges, such as energy constraints, limited computation capability, and intermittent network connectivity. In this paper, we present RAREST (AR Assisted GRound and AErial Sytem Twin), a digital twin (DT) framework for emulating such systems. RAREST simulates the CPU workload and energy consumption of each UAV based on different tasks, enables the cooperation and offloading between UAVs and UGVs, and provides an AR interface for human users to interact with the system. We describe the envisioned framework, its potential use cases, and its benefits over pure simulations. We also report our preliminary work simulating CPU workload and energy consumption for different object recognition tasks on UAVs and how this framework can be expanded and implemented in the future.},
booktitle = {Proceedings of the First Workshop on Metaverse Systems and Applications},
pages = {21–26},
numpages = {6},
keywords = {multi-UAV-UGV, augmented reality, digital twin, emulation},
location = {Helsinki, Finland},
series = {MetaSys '23}
}

@inproceedings{10.1145/3786171.3788384,
author = {Chagas, Matheus and Rodrigues, Gabryella and Rodrigues, Kalil and Holanda, Lucas and Alves, Vin{\'i}cius dos Santos and Benevides, Luis and Alves, Lucas Vieira and Maia, Paulo},
title = {Using Digital Games for Simulating Self-Adaptive Systems: A Case Study of Drone Missions in Minecraft},
year = {2026},
isbn = {9798400724039},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3786171.3788384},
doi = {10.1145/3786171.3788384},
abstract = {Digital games are increasingly explored beyond entertainment, serving as experimental infrastructures for simulation and software engineering research. In this context, Minecraft stands out as a modifiable, accessible, and community-supported platform that can be repurposed for scientific experimentation. This paper investigates the use of Minecraft as an alternative environment for simulating adaptive autonomous drones, focusing on runtime decision-making and adaptation in critical mission scenarios. A custom mod was developed to reproduce adaptive drone behaviors, enabling controlled experiments within the game. We defined metrics to evaluate six key dimensions — configuration, telemetry, autonomous logic, realism, reproducibility, and technical requirements. Results demonstrate that Minecraft can reproduce adaptive behaviors with low variability, offering a low-cost and extensible environment for prototyping. In conclusion, this work showcase how digital games can support experimentation and prototyping in self-adaptive systems.},
booktitle = {Proceedings of the ACM/IEEE 10th International Workshop on Games and Software Engineering},
pages = {89–96},
numpages = {8},
keywords = {Self-Adaptive Systems, Cyber-physical Components, Digital Games, Simulation, Drones},
location = {Rio de Janeiro, Brazil},
series = {GAS '26}
}

@inproceedings{10.1145/3662004.3663551,
author = {Lee, Mengjie and Hu, Yujiao and Zhu, Yining and Zhou, Xiaomao and Zhao, Yue and Zhou, Xingshe},
title = {Learn to Update Digital Twins with Incremental Scenarios},
year = {2024},
isbn = {9798400706615},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3662004.3663551},
doi = {10.1145/3662004.3663551},
abstract = {Digital twins serve as vital tools for monitoring and simulating real-world systems, yet ensuring their accuracy and adaptability in dynamic scenarios remains a challenge. In this paper, we introduce FlexiTwin, a digital twin updating assistance platform seamlessly integrated with AdaSor, a lightweight adaptive data selector. FlexiTwin automates the construction of incremental learning datasets for updating digital twins within specified time constraints, ensuring their adaptation to new scenarios while preserving historical knowledge. Through simulations focusing on UAV energy management, we show that FlexiTwin substantially enhances the adaptability of digital twins to new scenarios while effectively preserving their accuracy in historical scenarios.},
booktitle = {Proceedings of the 2nd International Workshop on Networked AI Systems},
pages = {7–12},
numpages = {6},
keywords = {Dataset construction, Digital twin, Incremental learning, Intelligent model updating, Scenario-sensitive updating},
location = {Minato-ku, Tokyo, Japan},
series = {NetAISys '24}
}

@inproceedings{10.1145/3638584.3638598,
author = {Wu, Meiliwen and Lv, Renli and Guan, Xiangmin},
title = {Design of Digital Air Traffic Management System for Multi-operator Unmanned Aerial Vehicle Based on Digital Twin},
year = {2024},
isbn = {9798400708688},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3638584.3638598},
doi = {10.1145/3638584.3638598},
abstract = {With the advancement of UAV technology, it is imperative to deliberate and practice the method of UAV operation management in greater detail. This paper presents a design scheme for an urban air traffic management data processing system based on a digital twin, which can solve the problem of multi-operator system digital management for conflict warning management. The system is composed of a digital core module, a digital control module, and a UAV twin flight module. The modules are linked to each other, and utilizing techniques like flight planning, comprehensive warning, and space processing, the twin-algorithm data analysis framework is constructed, and conflict predictions and predictions are made. The process of confirming the system described in this paper will be followed by further refinements and, with the assistance of the Bureau, the collection of information about the sector's activities to enhance the system.},
booktitle = {Proceedings of the 2023 7th International Conference on Computer Science and Artificial Intelligence},
pages = {501–506},
numpages = {6},
keywords = {UAV, digital twin, multi-operator, traffic management},
location = {Beijing, China},
series = {CSAI '23}
}

@inproceedings{10.1145/3776865.3776876,
author = {Li, Hui and Feng, Xu and Zhu, Yi and Chen, Zhenjia and Xiao, Hansong},
title = {Research on the Application of AI Digital Humans Built on UE5 in Agricultural Low-Altitude Economy Knowledge Lectures},
year = {2025},
isbn = {9798400721144},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3776865.3776876},
doi = {10.1145/3776865.3776876},
abstract = {This paper presents an intelligent digital human system architecture based on Unreal Engine 5 (UE5), constructing interactive AI digital humans for virtual knowledge lectures in the low-altitude domain. At the core technical level, it novel utilizes UE5's Blueprint visual programming to implement a dynamic calling mechanism for the DeepSeek API, enabling precise responses generated by a domain-knowledge-trained language model. In terms of application, the study pioneers the exploration of AI digital humans in the low-altitude economy, developing virtual assistants for airspace regulation, drone swarm scheduling, and low-altitude logistics services. Additionally, it establishes an immersive “Virtual Knowledge Lecture Hall” educational platform, leveraging UE5's real-time rendering and physically simulated environments to transcend the temporal limitations of traditional education.},
booktitle = {Proceedings of the 2025 3rd International Conference on Internet of Things and Cloud Computing Technology},
pages = {62–67},
numpages = {6},
keywords = {AI Digital Humans, Knowledge Lectures, Low-Altitude Economy, UE5},
location = {Haikou, China},
series = {IoTCCT '25}
}

@inproceedings{10.1145/3777730.3777785,
author = {Jiao, Yang},
title = {Computational Intelligence for Precision Agriculture: A Technical Review of Smart Sensing, Machine Vision, and Decision Support},
year = {2026},
isbn = {9798400718540},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3777730.3777785},
doi = {10.1145/3777730.3777785},
abstract = {With rising global demand for food and limited arable land, precision agriculture has become critical for maximizing crop yield while conserving resources. Modern farms leverage data-driven algorithms, advanced sensors, and smart systems to make real-time decisions. This survey reviews the state-of-the-art computational models and algorithms underpinning precision farming. We first examine IoT sensor networks and environmental monitoring: soil probes, weather stations, and aerial imaging generate large datasets for data fusion and model input. For example, water demand is often modeled by evapotranspiration equations such as the FAO Penman–Monteith formula (ETo = {textstyle{{0.408Delta ( {{R}_n - G} ) + gamma {textstyle{{900} over {T + 273}}}{u}_2( {{e}_s - {e}_a} )} over {Delta + gamma ( {1 + 0.34{u}_2} )}}} ), while vegetation health is measured by indices like (NDVI = {textstyle{{{I}_{NIR} - {I}_{Red}} over {{I}_{NIR} + {I}_{Red}}}}( {f{rm{*}}k} )( {x,y} )). Next, we survey computer vision and deep learning: convolutional neural networks (CNNs), detectors (Faster R-CNN, YOLO), and LSTM-based time-series models drive tasks such as crop classification, fruit/weed detection and yield prediction. For instance, LSTM networks update memory via gated recurrences ({c}_t = {f}_t odot {c}_{t - 1} + {i}_t odot {tilde{c}}_t). Finally, we discuss decision support systems for farm management: multi-source data fusion, interpretable models, and optimization of irrigation/fertilization schedules. Sample decision models include regression, random forests, and neural networks that map sensor inputs to yield estimates or resource plans. We identify ongoing challenges – data annotation, model generalization, and the integration of edge computing and digital twins – and outline future research directions toward fully autonomous smart farms.},
booktitle = {Proceedings of the 2025 International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {336–341},
numpages = {6},
