BASE         <http://nesped1.caf.ufv.br/context-drones>
PREFIX cod:  <#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX qu:   <http://purl.oclc.org/NET/ssnx/qu/qu#>
PREFIX dim:  <http://purl.oclc.org/NET/ssnx/qu/dim#>
PREFIX unit: <http://purl.oclc.org/NET/ssnx/qu/unit#>
PREFIX lang: <https://id.loc.gov/vocabulary/iso639-1/>
PREFIX cot: <http://nesped1.caf.ufv.br/od4cot>

# um DT mapeia propriedades, condições e comportamentos de um objeto fisico para um software digital 
# - 10.1109/JPROC.2020.2998530

# simulador de drone AirSim, Flightmare https://doi.org/10.1145/3769426

</definition> a owl:Ontology ;
    rdfs:comment "OD4CoT upper level definitions module." ;
    .

cot:Resource a owl:Class ;
    rdfs:comment "An informational or material resource." ;
    .

cot:Context a owl:Class ;
    rdfs:comment "A piece of information about the status or capabilities of an entity." ;
    rdfs:subClassOf cot:Resource ;
    .

cot:hasContext a owl:ObjectProperty ;
    rdfs:comment "Indicates that an object has a context." ;
    rdfs:domain cot:Resource ;
    rdfs:range cot:Context ;
    .

cot:SmartObject a owl:Class ;
    rdfs:comment "" ;
    rdfs:subClassOf cot:Resource ;
    .

cod:Article a owl:Class ;
    rdfs:comment "scientific text published in journals" ;
    .

cod:reference a owl:ObjectProperty;
    rdfs:comment "The article's DOI numbers that cite the context" ; 
    rdfs:domain cod:Article
    .

cod:citedBy a owl:ObjectProperty;
    rdfs:comment "" ; 
    rdfs:domain cod:Article
    .

# ======================= CONTEXTS OF DRONES ================================

cod:Speed a owl:Class ;
    rdfs:comment "The speed at which an object moves through space over time." ;
    rdfs:subClassOf cot:Context ;
    cod:citedBy [
        cod:reference "10.1109/TITS.2021.3108995";
        cod:reference "10.1109/TVT.2022.3152597";
        cod:reference "10.1109/LWC.2020.3014972";
        cod:reference "10.1109/TWC.2020.3015735";
