        cod:reference "10.1109/TMC.2022.3228870";
        cod:reference "10.1109/ICRA57385.2026.11696399";
        cod:reference "10.1109/ACCESS.2025.3648539";
        cod:reference "10.1109/ICNS69853.2026.11570433";
        cod:reference "10.1109/IWCMC65282.2025.11059545";
        cod:reference "10.3390/drones9070508";
        cod:reference "10.1016/j.scs.2022.104122";
        cod:reference "10.1109/ITC-Egypt55520.2022.9855753";
        cod:reference "10.1109/MAPCON58678.2023.10464130";
        cod:reference "10.1007/s13272-026-00961-3";
    ] ;
    # velocity
    # traffic parameters speed, flow, and occupancy
    # trafic factors visibility, rainfall, snowfall, road icing, and wind speed
    # high speed low speed cod:reference "10.1109/IWCMC65282.2025.11059545";
.

cod:Image a owl:Class;
    rdfs:comment "contexto resultante da captação de uma câmera";
    rdfs:domain cod:Camera;
    # estático (foto) ou dinâmico (vídeo)
    rdfs:subClassOf cot:Context ;
    cod:citedBy [
        cod:reference "10.1109/LWC.2020.3014972";
        cod:reference "10.1109/MIOT.2026.3661300";
        cod:reference "10.1109/IWCMC65282.2025.11059545";
    ]
.

