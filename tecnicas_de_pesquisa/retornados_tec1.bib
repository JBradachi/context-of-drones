@article{GUO2026111847,
title = {UAV-based crop pest and disease monitoring: A review of multi-source sensing and intelligent methods},
journal = {Computers and Electronics in Agriculture},
volume = {249},
pages = {111847},
year = {2026},
issn = {0168-1699},
doi = {https://doi.org/10.1016/j.compag.2026.111847},
url = {https://www.sciencedirect.com/science/article/pii/S0168169926004424},
author = {Jie Guo and Jin-Hai Li and Le Dong and Shun-Yu Wang and Guang-Yue Wu and Yu-Peng Zhang and Chang-Yong Tao and De-Hua Gao and Shu-Ming Yang and Yu-Tan Wang},
keywords = {UAV, Deeplearning, Multi-source sensing, Multimodal fusion, Crop pest and disease},
abstract = {Crop pests and diseases represent persistent threats to global food security, necessitating efficient and precise monitoring solutions. Utilizing a dataset comprising 7,445 publications spanning 2008–2025, this study conducts a comprehensive bibliometric and thematic analysis to elucidate the synergistic evolution of multi-source sensing and intelligent methods for unmanned aerial vehicle (UAV)-based crop pest and disease monitoring. Results identify a three-stage developmental trajectory, progressing from initial platform validation to sensor-algorithm co-development, and subsequently to system-integrated intelligent monitoring. Analysis further demonstrates that crop structural characteristics constitute a fundamental determinant in shaping monitoring paradigms; structural variations ranging from discrete orchard canopies to continuous field crop systems directly influence the definition of observation units and the selection of analytical strategies, thereby leading to differentiated methodological pathways. From a technological perspective, research has transitioned from reliance on single-source red–green–blue (RGB) imagery to multimodal frameworks integrating multispectral, hyperspectral, thermal infrared (TIR), and light detection and ranging (LiDAR) data. Concurrently, methodological development has evolved from conventional machine learning (ML) to deployment-oriented deep learning (DL) and vision-language models (VLMs). Furthermore, increasing attention is directed toward prescription-map-driven closed-loop frameworks, where diagnostic outputs are translated into spatially explicit intervention strategies for variable-rate application. Despite these advances, challenges persist in model generalization, dataset bias, and cross-platform standardization. This study provides a structured perspective for the development of scalable, physiologically-aware, and structure-aware intelligent monitoring solutions, contributing to the advancement of precision agriculture.}
}
@article{PAREDES2021115563,
title = {A Gaussian Process model for UAV localization using millimetre wave radar},
journal = {Expert Systems with Applications},
volume = {185},
pages = {115563},
year = {2021},
issn = {0957-4174},
doi = {https://doi.org/10.1016/j.eswa.2021.115563},
url = {https://www.sciencedirect.com/science/article/pii/S0957417421009696},
author = {José A. Paredes and Fernando J. Álvarez and Miles Hansard and Khalid Z. Rajab},
keywords = {Positioning system, Drone, Radar, Millimetre wave},
abstract = {The detection and positioning of unmanned aerial vehicles has become essential for both automation and surveillance tasks, in recent years. The design of accurate drone localization systems is challenging, especially in cluttered environments, where the target may be partially or even completely obscured. This paper proposes a precise detection and 3D localization system for drones, by means of a millimetre wave radar. Drone locations are estimated from spatial heatmaps of the received radar signals, which are obtained by applying the super-resolution MUSIC algorithm. These estimates are improved by analysis of the micro-Doppler effect, generated by the rotating propellers, which aids detection in poor visibility conditions. A novel Gaussian Process Regression model is developed, in order to compensate for systematic biases in the radar data. The complete system produces accurate estimates of the target range and direction, and is shown to outperform direct spectral analysis methods.}
}
@article{ABBAS2026113348,
title = {An adaptive balanced-weighted federated learning framework for fault diagnosis in heterogeneous multi-UAV systems},
journal = {Aerospace Science and Technology},
volume = {179},
pages = {113348},
year = {2026},
issn = {1270-9638},
doi = {https://doi.org/10.1016/j.ast.2026.113348},
url = {https://www.sciencedirect.com/science/article/pii/S1270963826017268},
author = {Nadir Abbas and Li-Ying Hao and Jamshed Iqbal and Ezzeddine Touti},
keywords = {Balanced-weighted federated learning, Fault diagnosis, Multi-UAV systems, Non-IID data, Formation control},
abstract = {Reliable fault diagnosis is essential for the safe operation of multi-UAV formations operating under heterogeneous and non-IID environments. However, conventional federated learning methods, such as FedAvg, often degrade under data imbalance and may lead to missed fault detections. This paper proposes a task-aware balanced-weighted federated learning (BW-FL) framework for fault-sensitive diagnosis in heterogeneous multi-UAV systems. Unlike conventional heterogeneity-aware federated learning methods that primarily focus on optimization consistency, the proposed approach explicitly incorporates local macro-F1 diagnostic performance and entropy-based class-distribution balance into the aggregation process. By prioritizing clients that are simultaneously reliable and fault-informative, the proposed method improves robustness under heterogeneous conditions. The framework is evaluated using physics-based multi-UAV simulations with thrust loss-of-effectiveness (LOE) and sensor bias faults across varying severity levels. Experimental results show that BW-FL achieves consistent improvements in accuracy, macro-F1 score, and fault recall under heterogeneous and imbalanced conditions while reducing missed fault detections relative to representative federated learning baselines. Multi-seed evaluations indicate stable diagnostic behavior of the proposed approach, while paired t-test and Wilcoxon signed-rank analyses suggest favorable but modest performance trends relative to the evaluated baseline methods. The proposed framework enhances fault diagnosis reliability in safety-critical UAV applications and provides a scalable foundation for distributed intelligent monitoring.}
}
@article{CEVIZ2025101592,
title = {A novel federated learning-based IDS for enhancing UAVs privacy and security},
journal = {Internet of Things},
volume = {31},
pages = {101592},
year = {2025},
issn = {2542-6605},
doi = {https://doi.org/10.1016/j.iot.2025.101592},
url = {https://www.sciencedirect.com/science/article/pii/S2542660525001052},
author = {Ozlem Ceviz and Pinar Sadioglu and Sevil Sen and Vassilios G. Vassilakis},
keywords = {UAV, Flying ad hoc networks (FANETs), Security, Privacy, Intrusion detection, Federated learning},
abstract = {Unmanned aerial vehicles (UAVs) operating within Flying Ad-hoc Networks (FANETs) encounter security challenges due to the dynamic and distributed nature of these networks. Previous studies focused predominantly on centralized intrusion detection, assuming a central entity responsible for storing and analyzing data from all devices. However, these approaches face challenges including computation and storage costs, along with a single point of failure risk, threatening data privacy and availability. The widespread dispersion of data across interconnected devices underscores the need for decentralized approaches. This paper introduces the Federated Learning-based Intrusion Detection System (FL-IDS), addressing challenges encountered by centralized systems in FANETs. FL-IDS reduces computation and storage costs for both clients and the central server, which is crucial for resource-constrained UAVs. Operating in a decentralized manner, FL-IDS enables UAVs to collaboratively train a global intrusion detection model without sharing raw data, thus avoiding delay in decisions based on collected data, as is often the case with traditional methods. Experimental results demonstrate FL-IDS’s competitive performance with Central IDS (C-IDS) while mitigating privacy concerns, with the Bias Towards Specific Clients (BTSC) method further enhancing FL-IDS performance even at lower attacker ratios. Comparative analysis with traditional intrusion detection methods, including Local IDS (L-IDS), sheds light on the strengths of FL-IDS. This study significantly contributes to UAV security by introducing a privacy-aware, decentralized intrusion detection approach tailored to UAV networks. Moreover, by introducing a realistic dataset for FANETs and federated learning, our approach differs from others lacking high dynamism and 3D node movements or accurate federated data federations.}
}
@article{WANG2023102377,
title = {Societal acceptance of urban drones: A scoping literature review},
journal = {Technology in Society},
volume = {75},
pages = {102377},
year = {2023},
issn = {0160-791X},
doi = {https://doi.org/10.1016/j.techsoc.2023.102377},
url = {https://www.sciencedirect.com/science/article/pii/S0160791X23001823},
author = {Ning Wang and Nico Mutzner and Karl Blanchet},
keywords = {Drones, Ethics, Societal acceptance, Technology governance, Value sensitive innovation},
abstract = {The use of drones (or Unmanned Aerial Vehicles) in urban areas has emerged rapidly in the last decade, and continues to expand at an accelerating pace. Alongside the emergent uses of high-impact technology in both public and private sectors, political debates about the potential risks and challenges have arisen, encompassing diverse perspectives and attitudes about the ethical, legal, social, and regulatory implications of introducing and integrating new technology in society. This scoping review offers an assessment of the societal acceptance factors of urban drones discussed in the current academic literature. We used a hybrid approach including quantitative landscape mapping and qualitative content analysis of the selected articles to inductively develop a typology of acceptance factors associated with urban use of drones. This review illuminates areas that have been the focus of attention within the current body of knowledge (e.g., visual and noise pollution of drones), sketches the evolution of the relevant discussions over time (e.g., a focus on the safety of the drone technology toward safety of the cargo it carries and security of the data it collects), and points to areas that have received less considerations (e.g., media appropriation and social group influence). It can, thus, help situate the topic of societal acceptance of urban drones in specific contexts, and orient future research on promoting value sensitive innovation in society more broadly.}
}
@article{YANG2026131234,
title = {Blockedge: Blockchain-based cloud-edge-end collaborative computing with optimized task offloading},
journal = {Expert Systems with Applications},
volume = {310},
pages = {131234},
year = {2026},
issn = {0957-4174},
doi = {https://doi.org/10.1016/j.eswa.2026.131234},
url = {https://www.sciencedirect.com/science/article/pii/S095741742600148X},
author = {Haotian Yang and Jun Dai and Xiao Chen and Lu Liu},
keywords = {Blockchain, Cloud-edge, Agricultural imaging, Offloading},
abstract = {Agricultural image processing can facilitate precise and real-time yield prediction, disease detection, and climate assessment from drone and satellite imagery. However, its adoption is hindered by massive volume of data, non-standardized IoT stacks, and security/integration barriers. In particular, cloud–edge–end collaboration suffers from two severe bottlenecks: (i) satellite-relay communication delays when direct edge–edge/cloud links are unavailable, and (ii) ineffectiveness of randomized leader-node selection in blockchain consensus, which may also slow block generation by selecting overloaded nodes. To address these challenges, this paper introduces BlockEdge, a blockchain-based cloud–edge collaborative system designed to improve security and computational efficiency in agricultural imaging within IoT frameworks. BlockEdge features a dual-chain architecture: an i-chain dedicated to image storage and a t-chain maintained by edge/cloud nodes for task recording and consensus. It is coupled with a hybrid GA–PSO optimization model that can jointly handle satellite-aware task offloading, computing-resource allocation, and leader-node selection. The optimization model integrates satellite transmission delay into the offloading decision and biases the leader selection toward high-capacity and low-load nodes so as to accelerate the block generation and consensus. The potential of BlockEdge is demonstrated by prototyping it with Hyperledger Fabric and NS-3 across diverse image sizes and network conditions. The obtained quantitative results in the absence of direct connectivity show that, in comparison to ground networks, BlockEdge can complete double tasks at a generation rate of 50 images/s, record approximately 22% more task transactions after 800 s, and reduce edge-to-edge transmission time to 59.2%, while maintaining superior storage capacity. These findings demonstrate the potential of BlockEdge for advancing sustainable agricultural practices and optimizing IoT applications in this field.}
}
@article{KULSHRESTHA2026103179,
title = {Governing the third dimension: An LST (Law-Security-Technology) framework analysis of India's drone ecosystem},
journal = {Social Sciences & Humanities Open},
volume = {14},
pages = {103179},
year = {2026},
issn = {2590-2911},
doi = {https://doi.org/10.1016/j.ssaho.2026.103179},
url = {https://www.sciencedirect.com/science/article/pii/S2590291126007448},
author = {Sandeep Kulshrestha and Nidhi Kastwar},
keywords = {Adaptive regulation, Drone regulation, Ethical and socio-technical oversight, Law–security–technology (LST) analytical lens, Risk-based governance, NPNT compliance},
abstract = {Unmanned Aircraft Systems (UAS), including Unmanned Aerial Vehicles (UAVs), have rapidly evolved from niche tools to pervasive technologies, creating complex intersections between law, security, and technological governance. This paper analyses India's evolving drone regulatory framework to assess how effectively it addresses emerging threats and vulnerabilities from civilian and autonomous operations. Employing a doctrinal–empirical hybrid approach, the study examines the Drone Rules 2021 (), institutional data from the Directorate General of Civil Aviation (DGCA), Border Security Force (BSF), and Ministry of Civil Aviation (MoCA), along with comparative models from the European Union, the United States, Japan, and Rwanda. The paper uses the Law–Security–Technology (LST) analytical lens to conceptualise how legal norms, enforcement mechanisms, and technical architectures interact to shape risk governance. Findings reveal persistent gaps between de jure norms and de facto enforcement, including limited compliance with No Permission–No Take-off (NPNT), inadequate local capacity, and unresolved liability for autonomous operations. The analysis further integrates ethical and community-based governance approaches and introduces a proportional cost–benefit (R/C) model for evaluating regulatory efficiency. The paper proposes an adaptive, risk-based hybrid model combining ethical oversight, technological standardisation, and fiscal incentives to enhance compliance without stifling innovation. The study advances an integrative analytical lens for examining how accountability, security, and technological innovation interact in drone governance. It further situates this analytical lens within contemporary debates on responsible innovation and adaptive regulation, emphasising the need for reflexive, value-aligned policymaking.}
}
@article{BRYANT2026121,
title = {Operational outcomes and feasibility of medical drones for healthcare delivery and vector control in emerging economies: a systematic review},
journal = {Global Health Journal},
volume = {10},
number = {2},
pages = {121-128},
year = {2026},
issn = {2414-6447},
doi = {https://doi.org/10.1016/j.glohj.2026.06.002},
url = {https://www.sciencedirect.com/science/article/pii/S2414644726000266},
author = {Nelson McNova Bryant and Gift Mwonzora},
keywords = {Medical drones, Healthcare delivery, Cost-effectiveness, Emerging economies},
abstract = {Background
Operational inadequacies in terrestrial transport infrastructure in emerging economies create significant barriers to healthcare access. Medical drones have been proposed as a technological solution to bypass geographic bottlenecks.
Objectives
This review aims to evaluate the operational outcomes, feasibility and cost- effectiveness of medical drone logistics across low- and middle-income settings. It investigates the comparative advantages of drones versus traditional ground transport in reducing delivery times and facilitating vector-control surveillance.
Methods
The systematic literature review consisted of a comprehensive search from PubMed for published academic journal articles. Additional databases included Embase, Google Scholar, and Scopus. As inclusion and exclusion criteria, the search strings focused on medical drones and health surveillance studies in the Global South. We used keywords, such as developing countries, low- and middle-income countries. A systematic search and screening process adhering to PRISMA 2020 guidelines identified 11 eligible studies published between 2016 and 2025. Included studies encompassed randomized and non-randomized trials, economic evaluations, and mixed studies. Each included study was evaluated against the relevant Mixed Methods Appraisal Tool criteria to generate a standardized risk of bias score.
Results
The systematic literature review shows that drones significantly reduce travel times by 50%‒80% compared with ground transport. In vaccine supply chains, drone integration reduced stockouts by 30% and missed vaccination opportunities by 44%. While initial capital costs remain high, recurrent operational costs may be lower than those for motorcycle logistics (0.34 USD vs. 1.40 USD per trip). In vector control, drone-based multispectral imagery can achieve higher accuracy (86%–98%) in identifying larval habitats than manual surveying methods.
Conclusions
Medical drones represent a significant tool for healthcare delivery in emerging economies, offering higher speed and accessibility. However, their impact on improving patients’ outcomes requires further research. Their integration requires ensuring community acceptance through conditional trust frameworks, and addressing technical limitations related to battery endurance and adverse weather conditions.}
}
@article{WANG2026105639,
title = {An improved soft actor-retrospective critic algorithm based on the dynamic fusion priority experience replay for UAV path planning},
journal = {Robotics and Autonomous Systems},
volume = {205},
pages = {105639},
year = {2026},
issn = {0921-8890},
doi = {https://doi.org/10.1016/j.robot.2026.105639},
url = {https://www.sciencedirect.com/science/article/pii/S0921889026003118},
author = {Li Wang and Chengyue Meng and Guodong Li and Xiaoran Kong and Lin Gao},
keywords = {Autonomous systems, UAV path planning, Deep reinforcement learning, Soft actor-retrospective critic, Experience replay, Artificial potential fields},
abstract = {Unmanned aerial vehicle (UAV) path planning in complex obstacle environments is critical for reliable autonomous navigation systems. Traditional deep reinforcement learning (DRL) algorithms suffer from low sample efficiency, slow convergence, and unstable obstacle avoidance performance in practical scenarios, limiting their engineering application. This study proposes an improved Soft Actor-Retrospective Critic (SARC) algorithm based on the Dynamic Fusion Priority Experience Replay (DFPER), combined with an action blending strategy based on Artificial Potential Fields (APF). The DFPER module dynamically screens high-value samples to enhance data efficiency, while the retrospective critic structure optimizes Q-value estimation accuracy and stability from a supervised learning perspective. Furthermore, the action blending strategy accelerates the convergence of the algorithm and improves flight safety. Comparative experiments in 2D obstacle scenarios demonstrate that the proposed method outperforms other advanced algorithms in terms of convergence speed, cumulative reward, path length, and collision avoidance rate. This work provides an effective solution for UAV autonomous navigation, with potential applications in real-word intelligent autonomous systems.}
}
@article{MATOS2027114011,
title = {System identification parameter study using lateral motion of a fixed-wing unmanned aerial vehicle with limited flight data},
journal = {Aerospace Science and Technology},
volume = {180},
pages = {114011},
year = {2027},
issn = {1270-9638},
doi = {https://doi.org/10.1016/j.ast.2026.114011},
url = {https://www.sciencedirect.com/science/article/pii/S1270963826023874},
author = {Nuno M.B. Matos and Francisco B.R. Machado and André C. Marta},
keywords = {Digital twin, Aircraft dynamics, Flight control, Flight test, System identification, Aerodynamic derivatives, Control derivatives, Optimisation},
abstract = {Accurate flight dynamic models are essential for performance assessment, certification, and safety assurance in the aerospace industry. While traditional aviation relies on dedicated flight test campaigns, the fast-paced UAV market often lacks resources and time. This work proposes a cost- and time-effective system identification methodology that eliminates dedicated flight testing by leveraging scarce, unplanned. A time-domain output-error optimization algorithm tunes simulated aircraft dynamics to match flight logs, targeting lateral-directional angular positions and rates. Using a medium-sized fixed-wing UAV as a case study, aerodynamic and control derivatives are identified directly from routine maneuvers. To overcome parameter bias and divergence typical of unexcited operational data, 210 state-error combinations and Lp-norm formulations were systematically evaluated. While single-manoeuvres lead to overfitting, multi-manoeuvre optimization with L0.5-norm standard deviation cost function provides the core breakthrough, effectively suppressing parameter estimation variance. The identified model achieves high predictive accuracy across unobserved validation maneuvers. This generic methodology extends to other motion characteristics, proving reliable digital twins can be calibrated from routine telemetry.}
}
@article{XIN2026102471,
title = {Task-driven Decentralized Decision-making Method for UAV Swarm with Behavior Regulation under Communication Delay},
journal = {Swarm and Evolutionary Computation},
volume = {107},
pages = {102471},
year = {2026},
issn = {2210-6502},
doi = {https://doi.org/10.1016/j.swevo.2026.102471},
url = {https://www.sciencedirect.com/science/article/pii/S2210650226001914},
author = {Ziwei Xin and Juan Li and Jie Li and Chang Liu},
keywords = {UAV swarm, Distributed decision-making, Communication delay, Trajectory prediction, Neighbors reselection},
abstract = {Classic swarm models attribute behavioral emergence to individual-level local interactions, enabling unmanned aerial vehicle (UAV) swarms to execute basic tasks. However, communication delay and packet loss caused by electromagnetic interference or link fluctuations trigger decision-making biases, severely limiting swarm adaptability to complex multi-task scenarios. To address this challenge, this study proposes a Delay Prediction-based Task-driven Swarm Decision-making Method (DP-TDDM), comprising three core modules: a front-end trajectory prediction module, a neighbors reselection module, and a back-end task-driven individual-level decision-making module. In the trajectory prediction module, a residual-corrected non-equidistant grey prediction model is established, which achieves high-precision small-sample prediction by dynamically updating the delay queue via a sliding window mechanism. In the neighbors reselection module, a quantitative criterion integrating information timeliness and flight safety is used to perform reselection and assign differentiated state weights to the new neighbors, thereby optimizing decision-making information source quality systematically. In the individual-level decision-making module, an orderly rule-behavior mapping is built to realize event-triggered, task-driven dynamic decision-making, which ensures conflict-free behavioral switching while preserving collective motion robustness. Based on a high-fidelity hardware-in-the-loop (HIL) simulation system, comprehensive performance comparisons are conducted between DP-TDDM and classic Intelligent Self-Organized Algorithm (ISOA), Weak Information Interaction UAV Swarm Model (WIIUSM) and their variants in multi-task scenarios. Results verify DP-TDDM’s effectiveness, robustness, and scalability, while additional experiments on delay prediction accuracy and behavior regulation effectiveness further corroborate its superiority. This study provides new insights based on classical swarm models and enhances the task adaptability of UAV swarms under communication delay.}
}
@article{CHEN2025128558,
title = {Multi-UAV path planning problem with biased sampling, candidate evaluation, and path reconfiguration in complex environment with threats},
journal = {Expert Systems with Applications},
volume = {291},
pages = {128558},
year = {2025},
issn = {0957-4174},
doi = {https://doi.org/10.1016/j.eswa.2025.128558},
url = {https://www.sciencedirect.com/science/article/pii/S0957417425021773},
author = {Zengxin Chen and Zhihao Luo and Xiaojie Jin and Jianmai Shi},
keywords = {Multi Unmanned aerial vehicle, Path planning, Rapidly Random-Exploring Tree Star (RRT*), Heuristic, Threats},
abstract = {The application of multiple Unmanned Aerial Vehicles (UAVs) in complex urban environments has demonstrated significant potential for emergency response, infrastructure inspection, and urban environmental monitoring. However, path planning for multi-UAV systems in such environments remains particularly challenging due to the presence of various threat zones, including obstacles, signal interference regions, and hazardous areas, which existing methods fail to address adequately. We present an enhanced grid-based modeling approach specifically designed for urban environments with distinct threat zones to bridge this gap. In addition, we propose an improved Multi-UAV Rapidly-exploring Random Tree Star (RRT*) algorithm integrated with Biased Sampling, Candidate Evaluation and Path Reconfiguration techniques (MU-RRT*-BCR). Specifically, the combination of biased sampling and candidate evaluation enhances node selection, reducing the average objective function value by 16.66% and CPU time by 80.28% compared to MU-RRT*. Additionally, a security detection mechanism is incorporated to prevent inter-UAV collisions. Moreover, a path reconfiguration technique is employed to refine the UAV trajectories, while the Dubins method is applied to ensure that the planned paths satisfy UAV kinematic constraints. Overall, extensive comparative studies validate our algorithm against several RRT* variants and A* algorithms. Compared to MU-RRT*, the proposed method reduces the average objective function value by 17.59% and CPU time by 81.26% while achieving 4.86% and 65.91% reductions, respectively, compared to A*. Furthermore, A practical case study based on Changsha’s skyline illustrates the method’s robustness and analyzes key factors impacting planning.}
}
@article{KU2026,
title = {Quantitative Stress Testing Using Scalable Digital Twin Simulation with MobileX Pole for Intelligent Mobile Surveillance},
journal = {Computers, Materials and Continua},
volume = {88},
number = {2},
year = {2026},
issn = {1546-2218},
doi = {https://doi.org/10.32604/cmc.2026.079582},
url = {https://www.sciencedirect.com/science/article/pii/S1546221826005916},
author = {DongHwan Ku and Sun Park and JongWon Kim},
keywords = {Quantitative stress testing, scalable digital twin, MobileX Pole, intelligent mobile surveillance},
abstract = {In future smart cities, ensuring urban safety requires data-driven decision-making through real-time monitoring tailored to dynamic, complex environments. Such surveillance relies on diverse mobile sensor devices, including drones, robots, patrol vehicles, and portable sensors. However, scaling and validating these systems directly in the real world is constrained by high costs, safety risks, and limited reproducibility across operating conditions. A scalable Digital Twin (DT) model can overcome these constraints by reproducing real-world mobile surveillance in a virtual environment, enabling large-scale simulations of sensor deployment, communication scenarios, and high-density visual data processing. Nevertheless, digital twins still face well-known limitations such as the reality gap, construction costs, limited coverage of behavioral and social variables, biased learning in AI models, and the need for continuous updates. Many of these issues are expected to be mitigated in the near future as generative AI increasingly automates the construction of virtual environments and objects. Despite these advancements, the systemic resource constraints of integrating large-scale physical sensor streams with virtual rendering remain underexplored. To address this gap, this paper proposes a scalable DT framework for the quantitative stress testing of intelligent mobile surveillance systems. The proposed framework collects real-world visualization data from multiple cameras mounted on MobileX Poles, and supports quantitative stress testing in both virtual and physical environments. It systematically analyzes how computing resource usage varies with the number of smart poles and the total number of camera streams under rendering conditions, thereby quantifying the resource limits of real-world, multi-camera DT simulations.}
}
@article{BRIONNE2026e00530,
title = {Pre-analytical stability of blood samples transported by drone versus ground: a pilot study},
journal = {Practical Laboratory Medicine},
volume = {50},
pages = {e00530},
year = {2026},
issn = {2352-5517},
doi = {https://doi.org/10.1016/j.plabm.2026.e00530},
url = {https://www.sciencedirect.com/science/article/pii/S2352551726000120},
author = {Marie Brionne and Laure Peyro-Saint-Paul and Jean-Jacques Dutheil and Denis Vivien and Hélène Legros and Simon {Le Hello} and Rémy Morello},
keywords = {Blood samples, Drone transport, Biochemical, Hematological parameters, Hemostasis, Laboratory quality},
abstract = {Objectives
Pre-analytical conditions are critical to ensure the reliability of laboratory results, as emphasized by ISO 15189 standards. Drone transport has emerged as a promising alternative to conventional logistics, but its impact on sample integrity remains insufficiently characterized. This pilot study aimed to assess the pre-analytical stability of blood samples transported by drone versus ground transport.
Methods
In this prospective study, 30 healthy volunteers were included. Six blood tubes per participant were collected simultaneously and assigned to ground or drone transport (20 min). A panel of 23 biochemical, hematological, and hemostatic parameters was analyzed. Agreement between transport modalities was assessed using paired comparisons, coefficients of variation, intraclass correlation coefficients (ICC), Pearson correlation, and Bland–Altman analysis.
Results
No clinically meaningful differences were observed between transport modalities. Mean values and variability were comparable across parameters. Most analytes showed excellent agreement, with ICC and Pearson correlation coefficients >0.90. Although ALT and LDH showed statistically significant differences (p = 0.039), these were small and clinically negligible. Bland–Altman analysis confirmed minimal bias for ALT (−0.63 U/L), whereas LDH exhibited wider limits of agreement, suggesting increased sensitivity to transport-related factors (−9.7 U/L). No hemolysis, temperature deviation, or safety incidents were observed.
Conclusions
Drone transport ensures robust pre-analytical stability of blood samples across a wide range of laboratory parameters. However, analyte-specific variability, particularly for LDH, highlights the need for targeted validation. These findings support the integration of drone-based logistics into laboratory workflows, while emphasizing the importance of analyte-dependent evaluation.}
}
@article{YANG2026102193,
title = {Technical–ethical–governance circuit–breaker framework for safe and sustainable AI governance},
journal = {Sustainable Futures},
volume = {12},
pages = {102193},
year = {2026},
issn = {2666-1888},
doi = {https://doi.org/10.1016/j.sftr.2026.102193},
url = {https://www.sciencedirect.com/science/article/pii/S2666188826005502},
author = {Chen-chun Yang and Yu-Te Lai and Ben-Chang Shia and Maria John Peter Selvamani and Chiung-Yun Lo and Ming Yi Chen and Yi-Si Liu},
keywords = {AI safety governance, Sustainable AI governance, Large language models, TEG framework, Dynamic risk tiering, Algorithmic governance, Responsible innovation},
abstract = {The growing use of large language models and autonomous AI systems in high-risk settings has created safety risks that cannot be addressed through technical safeguards alone. Existing approaches often treat technical failure control, ethical oversight, and institutional governance as separate domains, making coordinated intervention difficult when risks escalate across these boundaries. This study proposes the technical–ethical–governance (TEG) framework as an integrated circuit-breaker architecture for managing risks in high-risk AI systems. The framework combines technical, ethical, and governance risk signals and maps the resulting risk state to seven levels of intervention, ranging from monitoring and output restriction to human review and forced system shutdown. Minimum hold-time rules, authorization boundaries, and auditable records are incorporated to support stable escalation and accountable intervention. The framework is illustrated through three scenarios involving military-drone target misclassification, multimodal prompt injection, and an anonymized medical AI ethics committee. These scenarios illustrate how different types of risk can activate technical controls, human oversight, and governance responses and are not intended to constitute empirical validation of system performance. A structured comparison with IEEE 7009–2024 and ISO/IEC 42001:2023 further illustrates how the TEG framework may complement existing safety and management standards. The study also proposes preliminary response-time targets for future simulation and prototype evaluation. From a policy perspective, TEG provides a configurable architecture that can support resilient AI infrastructure, responsible technological deployment, and institutional accountability, with Taiwan serving as a context for localized governance.}
}
@article{REZAEE2026115145,
title = {Efficient multi-agent deep reinforcement learning algorithm for multi UAV collision avoidance},
journal = {Applied Soft Computing},
volume = {197},
pages = {115145},
year = {2026},
issn = {1568-4946},
doi = {https://doi.org/10.1016/j.asoc.2026.115145},
url = {https://www.sciencedirect.com/science/article/pii/S1568494626005934},
author = {Mohammad Reza Rezaee and Nor Asilah Wati {Abdul Hamid} and Masnida Hussin and Zuriati {Ahmad Zukarnain}},
keywords = {Unmanned aerial vehicle, Collision avoidance, Multi-agent learning, Deep reinforcement learning, Graph attention network},
abstract = {The rapid expansion of unmanned aerial vehicles (UAVs) across industries has led to increased airspace congestion. The increasing use of drones across many fields and locations has caused serious problems, especially in avoiding collisions. In the rapidly developing field of drone technology, ensuring UAV flight safety and reducing the risk of UAV collisions have therefore become urgent concerns. There are many artificial intelligence (AI) algorithms designed to solve this problem, but most work only in situations with a single agent. Multi-agent reinforcement learning is a promising way to solve these problems. It enables drones to operate with greater intelligence and flexibility, even in challenging situations, alongside other agents. This work presents a Multi-Agent Deep Reinforcement Learning algorithm based on efficient graph attention network for collision avoidance in a dense, complex multi UAV environment. We propose both curriculum learning and transfer learning by adding more agents over time and subsequently employing learning models. This makes the system more scalable and more coordinated. The training process is significantly enhanced by the suggested method, which outperforms the current baselines in continuous settings. Our findings indicate that the proposed approach achieves 17% higher cumulative reward, up to 10% fewer loss-of-separation time steps, and about 44% fewer active interaction edges than the benchmark. Furthermore, the proposed method reduces action-selection bias, improving decision-making stability in dense multi-UAV settings.}
}
@article{HE2026109474,
title = {Artificial intelligence and machine learning in predicting food hunger and severity: A comprehensive review},
journal = {Journal of Food Composition and Analysis},
volume = {158},
pages = {109474},
year = {2026},
issn = {0889-1575},
doi = {https://doi.org/10.1016/j.jfca.2026.109474},
url = {https://www.sciencedirect.com/science/article/pii/S0889157526006174},
author = {Shan He and Shabnam Mehboob and Naila Afghan and Nguyen Manh Hung},
keywords = {Food Insecurity, Machine Learning, Deep Learning, Early Warning Systems, Hunger Prediction, Remote Sensing},
abstract = {Food insecurity has been identified as one of the biggest twenty-first century humanitarian and public health emergencies. As of 2023, there are an estimated 733 million people facing food insecurity globally. The nature of food insecurity, which is shaped by the interwoven drivers of climate variability, armed conflict, economic shocks, structural poverty, etc., has historically surprised traditional prediction models. Artificial intelligence (AI) and machine learning (ML) have proven to be methodological tools with great potential to combine high-dimensional, heterogeneous data streams and produce early alerts of food insecurity onset, spatial mapping of food insecurity severity, and actionable intelligence for humanitarian response. This review aims to summarize the AI and ML use for worldwide food insecurity forecasting, including supervised methods like random forests, gradient boosting, and deep neural networks; clustering of unsupervised food insecurity vulnerabilities; the extraction of crisis signals from social media and news corpora using natural language processing; and the assessment of crop health through computer vision techniques applied to satellite and drone images. The operational platforms are critically examined about algorithmic foundations and predictive quality, such as the World Food Programme's Hunger Map Live, FEWS NET, FAO's Global Information and Early Warning System (GIEWS), and the Integrated Food Security Phase Classification (IPC). Persistent issues such as limited availability of data in conflict-affected areas, the lack of interpretability in models, algorithmic bias towards marginalized communities, and the digital infrastructure gap in low-income countries are further explored. The review also outlines a research agenda focused on federated learning architectures, explainable AI frameworks, and integrating climate non-stationarity into predictive models, aiming to bring algorithmic progress to policy action that will save lives and distribute benefits equitably.}
}
@article{ALSEHAIMI20252159,
title = {Optimising construction sector performance: A study of the rapidly growing global drone industry using smart PLS approach},
journal = {Journal of Engineering Research},
volume = {13},
number = {3},
pages = {2159-2170},
year = {2025},
issn = {2307-1877},
doi = {https://doi.org/10.1016/j.jer.2024.08.004},
url = {https://www.sciencedirect.com/science/article/pii/S2307187724002219},
author = {Abdullah Alsehaimi and Ahsan Waqar and Ahmed abd {El Aal} and Saleh Hayat and Faizan {Ahmed Waris} and Omrane Benjeddou},
keywords = {Artificial intelligence, Accountability, Operational effectiveness, Human resources, Profitability, Legal and privacy problems},
abstract = {The construction sector is dealing with a multitude of obstacles that may impede the accomplishment of a project, such as issues related to quality assurance, public health and safety, sustainability and the economy, environmental conservation, privacy, and legal limitations. Drones powered by artificial intelligence (AI) have a lot of promise to improve construction projects' overall performance, safety, sustainability, and operational efficiency. Still, there are many barriers preventing this powerful technology from being widely adopted. This research employed a mixed methodology that included surveys, expert interviews, literature reviews, and modelling to identify main challenges that construction professionals experience while using automated drones. The findings indicated that the biggest obstacles are a lack of finance, manpower, and privacy-related laws. It will cost money to train employees, negotiate regulatory restrictions, and weigh the advantages of automated drones in terms of both cost and environmental impact. However, to fully understand the potential enormous effects automated drones may have on construction projects, the construction industry must give top priority to resolving the important problems outlined here. Construction organisations can achieve significant improvements in accountability, operational effectiveness, and overall performance by focusing on growing human resources, achieving profitability, and addressing legal and privacy problems.}
}
@article{MWALUPASO2025107437,
title = {Rethinking household food security under a changing climate in drought prone areas of Ethiopia},
journal = {Land Use Policy},
volume = {150},
pages = {107437},
year = {2025},
issn = {0264-8377},
doi = {https://doi.org/10.1016/j.landusepol.2024.107437},
url = {https://www.sciencedirect.com/science/article/pii/S0264837724003909},
author = {Gershom Endelani Mwalupaso and Aseres Mamo Eshetie and Eunice Matafwali and Asma Akter and Hua Lu and Xianhui Geng},
keywords = {Climate-smart agriculture, Climate risk management, Food and nutrition security, Ethiopia},
abstract = {Climate-Smart Agriculture (CSA) is a strategic approach that can mitigate the impacts of climate change on food and nutrition security (FNS). Despite extensive research on this intersection, CSA adoption is often treated as a single, aggregate variable, which may obscure nuanced realities and choices that farmers confront. Additionally, empirical evidence linking CSA adoption to FNS remains limited in drought-prone areas, which face unique challenges such as degraded soils. This study addresses these gaps by using cross-sectional data from 909 farmers in Ethiopia to examine the factors influencing CSA adoption and its impact on FNS, while controlling for placement endogeneity. Applying multivariate probit and endogenous switching regression (ESR) models, we account for selection bias and endogenous covariates. Results show that 84 % of sampled households adopt at least one CSA practice, and CSA adopters generally exhibit higher household dietary diversity scores than non-adopters. Specifically, households implementing soil fertility practices consume an average of four additional food groups daily, while those adopting combinations of yield-boosting and soil fertility practices or yield-boosting and soil erosion control practices consume approximately three additional food groups. In a similar trend, households adopting both soil fertility and erosion control practices have a moderately enhanced diet, consuming two more food groups than their counterparts. Notably, increased crop income emerges as the compelling pathway linking CSA adoption with improved FNS outcomes. In light of the challenges posed by degraded soils and recurrent food insecurity in drought-prone areas, this study underscores the need to support CSA adoption through enhanced access to information, training, infrastructure, and credit, fostering more resilient agricultural systems and sustainable land use.}
}
@article{LI2026113931,
title = {Audio denoising and audio-visual localization for unmanned aerial vehicles},
journal = {Pattern Recognition},
volume = {179},
pages = {113931},
year = {2026},
issn = {0031-3203},
doi = {https://doi.org/10.1016/j.patcog.2026.113931},
url = {https://www.sciencedirect.com/science/article/pii/S0031320326008964},
author = {Zhaojian Li and Jianbo Li and Dengdian Huang and Jianbin Jiao and Jingzhu Li and Bin Zhao},
keywords = {Unmanned aerial vehicle, Audio denoising, Audio-visual localization, Multimodal perception},
abstract = {The unmanned aerial vehicle (UAV) is increasingly drawing attention for its broad potential in disaster response, public safety, and intelligent monitoring. However, noise interference from UAV poses significant challenges to its audio-visual perception capabilities. To address these challenges, we introduce a novel task that integrates UAV audio-visual denoising and localization. To facilitate this research, we collect and construct a UAV audio-visual dataset in real-world environments. The dataset comprises audio and video captured by UAV, along with synchronized ground-based audio, providing a high-quality audio-visual benchmark for this task. We propose a visually guided audio denoising (VGAD) model, which generates a noise suppression mask through visual guidance to effectively attenuate UAV noise. To alleviate the perceptual similarity bias caused by single-anchor modeling, we propose an audio-visual anchor interaction (AVAI) localization model composed of an audio anchor localization (AAL) module and a visual anchor localization (VAL) module. The two modules leverage unsupervised dual contrastive learning to comprehensively capture perceptual similarities between the audio and visual modalities, thereby enhancing cross-modal semantic consistency and improving audio-visual localization performance. Extensive experiments on UAV audio-visual denoising and localization demonstrate that the proposed models significantly suppress UAV noise and improve localization performance. This work is the first to extend audio-visual localization to UAV scenarios, facilitating the advancement of UAV multimodal perception.}
}
@article{YAN2026181811,
title = {High-precision and multi-modal monitoring of UAV using flexible and durable magnetoelectric sensors based on interface-engineered piezoelectric polyurethane/MnFe2O4 composite},
journal = {Chemical Engineering Journal},
volume = {548},
pages = {181811},
year = {2026},
issn = {1385-8947},
doi = {https://doi.org/10.1016/j.cej.2026.181811},
url = {https://www.sciencedirect.com/science/article/pii/S1385894726092740},
author = {Lincun Yan and Xian Li and Jie Xu and Longtai Jiang and Qiming Wang and Jinrong Li and Yong Xiang and Xiaoran Hu},
keywords = {Magnetoelectric composites, Strain-sensitive polyurethane, UAV monitoring, Brushless motors, Titanate 401 coupling agent, MnFeO},
abstract = {With the growth of low-altitude economy, the rapid spread of unmanned aerial vehicles (UAVs) accompanied by frequent safety accidents has created demands for real-time and in-situ monitoring of their propulsion systems, which are responsible for most of the UAV accidents. However, the limited space and energy supply in propulsion systems pose significant challenges to develop miniature size, high flexibility, low power dissipation, and multi-modal integration of sensors. In this work, a flexible magnetoelectric composite sensor (MCS) was developed using an intrinsically piezoelectric polyurethane (SS-PU) matrix and titanate-modified MnFe2O4 (MFO) nanoparticles. The piezoelectric polyurethane is synthesized with phase-separated segments, whose polyester-based soft segments provide numerous CO dipoles to achieve high piezoelectricity, and the aromatic and disulfide hard segments provide mechanical strength. Additionally, by using a titanate coupling agent as a “molecular bridge” for interfacial engineering, the compatibility between the filler and matrix is highly improved, leading to high efficiency in strain transfer between them. As a result, the composite achieved a notable magnetoelectric coupling coefficient of 33.11 mV/cm∙Oe, which is nearly two times compared with that of unmodified composites. The optimized MCS shows a high sensitivity of 2.365 mV/kPa, an ultra-fast response time of 4.2 ms, and a tensile strength of 10.1 MPa. In brushless motor rotation speed monitoring, it presents a linear correlation coefficient of R2 = 0.99998 and an error < 1.5%. Additionally, the composite sensor supports multi-modal sensing of complex flight conditions, including rotation speed, mechanical vibration, and transient impact. This research offers a new approach to building integrated structural health monitoring systems for future intelligent propulsion systems.}
}
@article{LI2027114045,
title = {Confident detection: unmanned aerial vehicles anomaly detection under data contamination via uncertainty calibration},
journal = {Aerospace Science and Technology},
volume = {180},
pages = {114045},
year = {2027},
issn = {1270-9638},
doi = {https://doi.org/10.1016/j.ast.2026.114045},
url = {https://www.sciencedirect.com/science/article/pii/S1270963826024211},
author = {Wenbo Li and Junjie Jiang and Zuoyi Chen and Jun Wu and Hong-Zhong Huang},
keywords = {Unmanned aerial vehicles, Anomaly detection, Data contamination, Uncertainty guided penalty, Synthetic anomaly perturbation},
abstract = {Anomaly detection is essential for ensuring the operational safety and mission availability of unmanned aerial vehicles (UAV). Existing methods usually construct anomaly detection models by learning normal flight patterns from training data. However, they commonly assume that the training set is purely normal and often lack explicit anomaly priors. In practical UAV systems, training data are frequently contaminated by unlabeled anomalies or strong noise, which can distort normality modeling and lead to a biased decision boundary. To address this problem, this paper proposes a dual calibration network, termed DualCal, for confident UAV anomaly detection. DualCal constructs a compact normal state hypersphere in the feature space and calibrates its boundary through two complementary modules. The uncertainty guided penalty module adaptively reduces the optimization weight of low confidence samples to suppress the influence of contaminated data, while the synthetic anomaly perturbation module generates diverse synthetic anomalies to provide anomaly aware supervision and sharpen the decision boundary. Experiments on two UAV datasets demonstrate that DualCal consistently outperforms 12 state-of-the-art baselines under both clean and contaminated training conditions, confirming its superior detection accuracy and robustness.}
}
@article{GORCUN2027113970,
title = {Managing uncertainty in aerospace technology evaluation: A data-driven rough multi-criteria decision framework for delivery UAVs},
journal = {Aerospace Science and Technology},
volume = {180},
pages = {113970},
year = {2027},
issn = {1270-9638},
doi = {https://doi.org/10.1016/j.ast.2026.113970},
url = {https://www.sciencedirect.com/science/article/pii/S1270963826023461},
author = {Ömer Faruk Görçün and Abhijit Saha and Fatih Ecer},
keywords = {Unmanned aerial vehicles (UAVs), Systems engineering, Rough numbers, Last-mile logistics, MCDM, Decision support systems},
abstract = {Selecting Unmanned Aerial Vehicles (UAVs) for last-mile delivery is a strategic decision problem characterized by numerous uncertain, interrelated, and conflicting criteria, for which conventional decision-making tools remain insufficient. This study proposes an integrated Rough WENSLO–CoCoFISo framework that models expert-elicitation uncertainty through rough numbers, derives objective, bias-independent criterion weights via the Rough WENSLO method, and ranks alternatives via the Rough CoCoFISo method. The term “data-driven” is used specifically to describe the way rough-number interval boundaries are derived directly from the dispersion of the pooled expert ratings, rather than from a machine-learning process; this usage is clarified explicitly in the Introduction. The framework is applied to a real-world case study of six commercial UAV platforms (A1–A6) evaluated against eleven technical, operational, economic, environmental, and safety/compliance criteria by a five-member, multidisciplinary expert panel. C5 (Delivery Accuracy and Drop Mechanism) is identified as the most influential criterion, and Flytrex (A6) is obtained as the top-ranked alternative, with UPS Flight Forward/Wingcopter (A5) close behind. The model's robustness is confirmed through k-parameter sensitivity analysis, a Monte Carlo simulation of criterion-weight perturbations, and comparison with rough MARCOS, WASPAS, and ARAS. The study contributes an uncertainty-oriented, industrially implementable decision-support framework for UAV selection, with actionable insights for logistics operators, UAV manufacturers, and regulators.}
}
@article{COMER2024,
title = {Short- and Long-Term Predicted and Witnessed Consequences of Digital Surveillance During the COVID-19 Pandemic: Scoping Review},
journal = {JMIR Public Health and Surveillance},
volume = {10},
year = {2024},
issn = {2369-2960},
doi = {https://doi.org/10.2196/47154},
url = {https://www.sciencedirect.com/science/article/pii/S2369296024001200},
author = {Leigha Comer and Lorie Donelle and Bradley Hiebert and Maxwell J Smith and Anita Kothari and Saverio Stranges and Jason Gilliland and Jed Long and Jacquelyn Burkell and Jacob J Shelley and Jodi Hall and James Shelley and Tommy Cooke and Marionette {Ngole Dione} and Danica Facca},
keywords = {digital surveillance, COVID-19, public health, scoping review, pandemic, digital technologies},
abstract = {Background
The COVID-19 pandemic has prompted the deployment of digital technologies for public health surveillance globally. The rapid development and use of these technologies have curtailed opportunities to fully consider their potential impacts (eg, for human rights, civil liberties, privacy, and marginalization of vulnerable groups).
Objective
We conducted a scoping review of peer-reviewed and gray literature to identify the types and applications of digital technologies used for surveillance during the COVID-19 pandemic and the predicted and witnessed consequences of digital surveillance.
Methods
Our methodology was informed by the 5-stage methodological framework to guide scoping reviews: identifying the research question; identifying relevant studies; study selection; charting the data; and collating, summarizing, and reporting the findings. We conducted a search of peer-reviewed and gray literature published between December 1, 2019, and December 31, 2020. We focused on the first year of the pandemic to provide a snapshot of the questions, concerns, findings, and discussions emerging from peer-reviewed and gray literature during this pivotal first year of the pandemic. Our review followed the PRISMA-ScR (Preferred Reporting Items for Systematic Reviews and Meta-Analyses Extension for Scoping Reviews) reporting guidelines.
Results
We reviewed a total of 147 peer-reviewed and 79 gray literature publications. Based on our analysis of these publications, we identified a total of 90 countries and regions where digital technologies were used for public health surveillance during the COVID-19 pandemic. Some of the most frequently used technologies included mobile phone apps, location-tracking technologies, drones, temperature-scanning technologies, and wearable devices. We also found that the literature raised concerns regarding the implications of digital surveillance in relation to data security and privacy, function creep and mission creep, private sector involvement in surveillance, human rights, civil liberties, and impacts on marginalized groups. Finally, we identified recommendations for ethical digital technology design and use, including proportionality, transparency, purpose limitation, protecting privacy and security, and accountability.
Conclusions
A wide range of digital technologies was used worldwide to support public health surveillance during the COVID-19 pandemic. The findings of our analysis highlight the importance of considering short- and long-term consequences of digital surveillance not only during the COVID-19 pandemic but also for future public health crises. These findings also demonstrate the ways in which digital surveillance has rendered visible the shifting and blurred boundaries between public health surveillance and other forms of surveillance, particularly given the ubiquitous nature of digital surveillance.
International Registered Report Identifier (IRRID)
RR2-https://doi.org/10.1136/bmjopen-2021-053962}
}
@article{YASMINE2023200296,
title = {Anti-drone systems: An attention based improved YOLOv7 model for a real-time detection and identification of multi-airborne target},
journal = {Intelligent Systems with Applications},
volume = {20},
pages = {200296},
year = {2023},
issn = {2667-3053},
doi = {https://doi.org/10.1016/j.iswa.2023.200296},
url = {https://www.sciencedirect.com/science/article/pii/S2667305323001217},
author = {Ghazlane Yasmine and Gmira Maha and Medromi Hicham},
keywords = {Deep learning, Real-time detection, Airspace safety, Drone identification},
abstract = {Recently, with the significant rise of drones, reinforcing and securing aerial security and privacy has become an urgent task. Their malicious use takes benefit from the malevolent deployment which leverages some existing gaps in Artificial Intelligence (AI) and cybersecurity. Anti-drone systems are the spotlighted security solution developed to ensure aerial safety and security against rogue drones. However, the anti-drone systems are constraints to accurate airborne target identification and real-time detection to neutralize the target properly without causing damages. In this paper, we have developed a real-time multi-target detection model based on Yolov7 aiming to detect, identify and locate the airborne target properly and rapidly using a varied dataset which is biased and imbalanced due to the differences between the targets. In order to develop a model with the best compromise between a high performance and fast speed, we have used a series of improvements by incorporating the CSPResNeXt module in the backbone, a transformer block with the C3TR attention mechanism and decoupled head structure to enhance the performance of the model. The comparative and ablation experiments confirm the effectiveness of the proposed ensemble learning-based model. The experiments have shown that the improved model has reached high performance, with 0.97 precision, 0.961 recall, 0.979 map@0.50 and 0.732 and 0.979 map@0.50–0.95. Additionally, the real-time detection condition is satisfied with 92 FPS and an inference speed equal to 0.02 ms per image. The results show that the model succeeds in achieving an optimal balance between inference speed and detection performance. The proposed model achieves competitive results compared with the existing state-of-the-art models.}
}